@startuml
actor "Usuário (Administrador)" as usuario
participant "View: index.blade.php" as view
participant "ProdutoController" as produtoController
participant "ProdutoConsumidoController" as produtoConsumidoController
participant "RelatorioController" as relatorioController
database "Model: Produto" as modelProduto
database "Model: ProdutoConsumido" as modelProdutoConsumido
database "Model: Usuario" as modelUsuario

== Visualizar Dados ==
activate usuario
usuario -> view: Acessa a página principal
activate view
deactivate usuario

view -> produtoController: Solicita dados de produtos
activate produtoController
produtoController -> modelProduto: Consulta todos os produtos
activate modelProduto
modelProduto --> produtoController: Lista de produtos
deactivate modelProduto
deactivate produtoController

view -> produtoConsumidoController: Solicita dados de produtos consumidos
activate produtoConsumidoController
produtoConsumidoController -> modelProdutoConsumido: Consulta todos os produtos consumidos
activate modelProdutoConsumido
modelProdutoConsumido --> produtoConsumidoController: Lista de produtos consumidos
deactivate modelProdutoConsumido
deactivate produtoConsumidoController

view -> usuario: Exibe dados de produtos e produtos consumidos
deactivate view

== Emitir Relatórios ==
usuario -> relatorioController: Solicita relatórios
activate relatorioController

relatorioController -> modelProdutoConsumido: Consulta todos os produtos consumidos (dividas)
activate modelProdutoConsumido
modelProdutoConsumido --> relatorioController: Lista de produtos consumidos (dividas)
deactivate modelProdutoConsumido

relatorioController -> modelProdutoConsumido: Consulta todos os produtos consumidos (rateio)
activate modelProdutoConsumido
modelProdutoConsumido --> relatorioController: Lista de produtos consumidos (rateio)
deactivate modelProdutoConsumido

relatorioController -> modelProduto: Consulta todos os produtos
activate modelProduto
modelProduto --> relatorioController: Lista de produtos
deactivate modelProduto

relatorioController -> modelUsuario: Consulta todos os usuários
activate modelUsuario
modelUsuario --> relatorioController: Lista de usuários
deactivate modelUsuario

relatorioController -> usuario: Retorna relatórios
deactivate relatorioController
@enduml